# Copiez ce fichier en .env et remplissez ce dont vous avez besoin.
# .env est ignoré par git. Ne le renommez pas.
# Tout n'est pas nécessaire : ne renseignez que les outils que vous utilisez.

# --- Modèles ---
ANTHROPIC_API_KEY=

# --- CMS / site ---
CMS_API_TOKEN=
CMS_SITE_ID=

# --- CRM ---
CRM_API_TOKEN=
CRM_PORTAL_ID=

# --- Régies publicitaires ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- SEO / analytics ---
SEO_TOOL_API_KEY=
SEARCH_CONSOLE_SITE_URL=

# --- Google Workspace (compte de service) ---
# La clé JSON ne vit PAS dans le repo : ~/.config/<votre-projet>/service-account-key.json
GOOGLE_SA_KEY=
GOOGLE_SA_SUBJECT=

# --- Emailing ---
EMAIL_API_KEY=
